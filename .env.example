# Contact form email delivery (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional contact form overrides
# Defaults:
# - CONTACT_FROM_EMAIL falls back to SMTP_USER
# - CONTACT_TO_EMAIL falls back to kevin@recordentertainment.com
# CONTACT_FROM_EMAIL=no-reply@recordentertainment.com
# CONTACT_TO_EMAIL=kevin@recordentertainment.com

# Optional existing booking integration
HONEYBOOK_WEBHOOK_URL=
